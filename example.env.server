G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=

# Optional: restrict /api/detail scraping to specific domains.
# Comma-separated host rules: exact (example.com) or suffix (*.example.com, .example.com)
DETAIL_ALLOWLIST=

# Optional: denylist for /api/detail.
# Comma-separated host rules: exact (example.com) or suffix (*.example.com, .example.com)
DETAIL_BLOCKLIST=

# Optional: /api/detail basic abuse protection / resource bounds
# Set to 0 to disable.
# Recommended for public deployments on Vercel (no external KV/Redis): keep conservative.
DETAIL_RATE_LIMIT_PER_MIN=20
DETAIL_CACHE_MAX_ENTRIES=100

# Optional: Zhihu API cookie for /api/detail zhihu extraction (may be required by anti-bot).
DETAIL_ZHIHU_COOKIE=

# Public /api/detail token (for unauthenticated access). If unset, token feature is disabled.
DETAIL_PUBLIC_JWT_SECRET=
# Default 900 seconds (15 minutes)
DETAIL_PUBLIC_TOKEN_TTL_SECONDS=900
# Rate limit for minting public tokens per IP
DETAIL_PUBLIC_TOKEN_RATE_LIMIT_PER_MIN=30
